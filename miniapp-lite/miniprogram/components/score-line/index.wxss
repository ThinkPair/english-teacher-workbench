:host { display:block; width:100%; }
.line-wrap { width:100%; position:relative; overflow:hidden; }
.line-canvas { width:100%; display:block; position:absolute; left:-10000px; top:0; }
.chart-image { width:100%; display:block; }
.chart-empty { height:100%; min-height:90px; display:flex; flex-direction:column; align-items:center; justify-content:center; border-bottom:1px dashed #E9ECF1; color:#303642; font-size:13px; box-sizing:border-box; }
.empty-sub { margin-top:7px; font-size:12px; color:#737C89; }
