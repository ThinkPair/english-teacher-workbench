/* Shared clear-white design tokens; orange reserved for action and selection. */
page {
  --canvas: #F6F7F9; --surface: #FFFFFF; --surface-muted: #F3F5F8;
  --line: #E9ECF1; --ink: #303642; --title: #202631; --muted: #737C89;
  --accent: #CB4A20; --accent-soft: #FFF1EB; --accent-line: #F0C7B8;
  --danger: #AD4535; --success: #437562;
  background: var(--canvas); color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
}
view, text, input, textarea, button, image { box-sizing: border-box; }
button { font-size: 28rpx; font-weight: 600; margin: 0; border-radius: 16rpx; line-height: 1.45; }
/* Preserve native v2 button sizing: custom controls must not inherit fixed width. */
button:not([size='mini']) { width: auto; min-width: 0; max-width: 100%; margin-left: 0; margin-right: 0; box-sizing: border-box; }
button::after { border: 0; }
input, textarea { width: 100%; font-family: inherit; font-size: 29rpx; }
button[disabled] { opacity: .45; }
